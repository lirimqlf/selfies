# Copiez ce fichier en .env et remplissez les valeurs (ne le commitez JAMAIS)
DISCORD_TOKEN=votre_token_discord_ici

# Clé de chiffrement des données au repos. Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Plusieurs clés possibles séparées par des virgules (la 1re chiffre) → rotation.
# Sauvegardez-la ailleurs : sans elle, les données sont irrécupérables.
DATA_ENCRYPTION_KEY=votre_cle_fernet_ici

# Optionnel
DATA_DIR=.
PRIVACY_URL=https://VOTRE-PSEUDO.github.io/selfies/privacy.html
TERMS_URL=https://VOTRE-PSEUDO.github.io/selfies/terms.html
